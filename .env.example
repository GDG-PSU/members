# ---------------------------------------------------------------------------
# GDG@PSU Members — environment template. Copy to .env.local (web) and .env
# (scripting). Never commit real values. The secret/service key is server-only:
# it must never be prefixed with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

# Public site origin used for auth callbacks and absolute links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project (public anon key is safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only Supabase secret key (new key format) or legacy service role key.
SUPABASE_SECRET_KEY=your-secret-key
SUPABASE_SERVICE_ROLE_KEY=

# Server-only 32-byte key (base64) used to encrypt one-time card write payloads.
CARD_WRITE_ENCRYPTION_KEY=

# Support address shown to members.
NEXT_PUBLIC_SUPPORT_EMAIL=gdg@psu.edu

# Direct Postgres connection for migration scripts (Supabase pooler, IPv4).
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:password@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Optional: comma-separated GitHub handle allowlist is NOT used. Roles are
# granted explicitly with `pnpm db:bootstrap-admin --email you@psu.edu`.
